# Envío real de correos (bienvenida y recuperación de contraseña) desde ms-notificaciones.
# 1. Copia este archivo como  correo.env  (está en .gitignore: tu contraseña NO se sube a GitHub).
# 2. Completa tus datos y vuelve a iniciar el backend con ./scripts/iniciar-backend.sh
#
# Gmail: necesitas la verificación en 2 pasos activa y una «contraseña de aplicación» de 16 letras
# (https://myaccount.google.com/apppasswords). NO uses tu contraseña normal de Gmail.

MAIL_ACTIVO=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx
MAIL_FROM=tu_correo@gmail.com
