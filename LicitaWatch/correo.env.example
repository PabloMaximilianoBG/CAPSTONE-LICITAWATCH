# Envío real de correos (bienvenida, recuperación de contraseña y notificaciones) desde ms-notificaciones.
# Los correos salen de la casilla oficial del proyecto: licitawatch@gmail.com (ya viene por defecto).
# 1. Copia este archivo como  correo.env  (está en .gitignore: la contraseña NO se sube a GitHub).
# 2. Pega en SMTP_PASS la «contraseña de aplicación» de licitawatch@gmail.com (pídesela al equipo)
#    y vuelve a iniciar el backend con ./scripts/iniciar-backend.sh
#
# Es una contraseña de aplicación de 16 letras (https://myaccount.google.com/apppasswords),
# NO la contraseña normal de la cuenta de Gmail.

MAIL_ACTIVO=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_USER=licitawatch@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx
MAIL_FROM=licitawatch@gmail.com
