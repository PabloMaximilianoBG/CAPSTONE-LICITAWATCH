<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.4</version>
    <relativePath/>
  </parent>
  <groupId>cl.licitawatch</groupId>
  <artifactId>licitawatch</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>
  <name>LicitaWatch</name>
  <properties>
    <java.version>21</java.version>
    <jjwt.version>0.12.6</jjwt.version>
  </properties>
  <!-- Todo el backend vive en microservicios/: una carpeta por microservicio (usuarios/, licitaciones/, ventas/,
       notificaciones/, chat/, asistente/) más licitawatch-common/. El API Gateway (entrada única) va aparte, en api-gateway/.
       Cada microservicio se divide en 3 capas desplegadas por separado, cada una con su puerto:
       BFF 808x (la llama el API Gateway) → BS 818x (negocio) → BD 828x (única con PostgreSQL).
       Ventas tiene además su Ambassador (8383), el único que habla con la pasarela de pago externa. -->
  <modules>
    <module>microservicios/licitawatch-common</module>
    <module>microservicios/usuarios/ms-usuarios-bd</module>
    <module>microservicios/usuarios/ms-usuarios-bs</module>
    <module>microservicios/usuarios/ms-usuarios-bff</module>
    <module>microservicios/licitaciones/ms-licitaciones-bd</module>
    <module>microservicios/licitaciones/ms-licitaciones-bs</module>
    <module>microservicios/licitaciones/ms-licitaciones-bff</module>
    <module>microservicios/ventas/ms-ventas-bd</module>
    <module>microservicios/ventas/ms-ventas-bs</module>
    <module>microservicios/ventas/ms-ventas-bff</module>
    <module>microservicios/ventas/ms-ventas-ambassador</module>
    <module>microservicios/notificaciones/ms-notificaciones-bd</module>
    <module>microservicios/notificaciones/ms-notificaciones-bs</module>
    <module>microservicios/notificaciones/ms-notificaciones-bff</module>
    <module>microservicios/chat/ms-chat-bd</module>
    <module>microservicios/chat/ms-chat-bs</module>
    <module>microservicios/chat/ms-chat-bff</module>
    <module>microservicios/asistente/ms-asistente-bs</module>
    <module>microservicios/asistente/ms-asistente-bff</module>
    <module>api-gateway</module>
  </modules>
</project>
